<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="5dp"
    android:background="#FFFFFF"
    android:elevation="4dp"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardNhacHieuUng"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        app:cardBackgroundColor="#fff"
        app:cardCornerRadius="5dp"
        app:cardElevation="3dp"
        app:rippleColor="#33000000"
        app:strokeColor="#000000"
        app:strokeWidth="0dp">

        <LinearLayout
            android:background="@drawable/bg_caidat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10sp">

            <TextView
                android:id="@+id/txtTenNhacHieuUng"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/sono"
                android:text="Âm thanh hiệu ứng 1"
                android:textColor="#000"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/txtGhiChu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="@font/sono"
                android:text="Nhịp điệu mở đầu phim vui tươi, đầu phim năng động"
                android:textColor="#000"
                android:textSize="15sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>


</LinearLayout>