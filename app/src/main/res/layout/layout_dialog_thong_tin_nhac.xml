<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:layout_margin="10sp"
    android:background="@drawable/bg_loading"
    android:gravity="left"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/sono"
            android:text="Xác nhận"
            android:textColor="#000"
            android:textSize="20sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThoat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="#FFFFFF"
            app:cardCornerRadius="5dp"
            app:cardElevation="12dp"
            app:rippleColor="#33000000"
            app:strokeColor="#000000"
            app:strokeWidth="0.5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/sono"
                android:gravity="center"
                android:padding="5sp"
                android:text="❌"
                android:textColor="#000"
                android:textSize="17sp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>


    <LinearLayout
        android:id="@+id/layoutLinkDrive"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_menu2"
        android:gravity="center"
        android:padding="10sp">

        <TextView
            android:id="@+id/txtLinkDrive"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:fontFamily="@font/sono"
            android:gravity="left"
            android:text="Tải xuống tại Google Drive"
            android:textColor="#2196F3"
            android:textSize="15dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLinkYouTube"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_menu2"
        android:gravity="center"
        android:padding="10sp">

        <TextView
            android:id="@+id/txtLinkYouTube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autoLink="web"
            android:fontFamily="@font/sono"
            android:gravity="left"
            android:text="Xem trên YouTube"
            android:textColor="#2196F3"
            android:textSize="15dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/layoutLinkAndroid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_menu2"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10sp">

        <TextView
            android:id="@+id/txtLinkAndroid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/sono"
            android:gravity="left"
            android:text="Xem trên máy \naaa"
            android:textColor="#2196F3"
            android:textSize="15dp" />

    </LinearLayout>


</LinearLayout>