<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="60dp"
        android:paddingTop="70dp"
        android:paddingBottom="70dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="100dp"
                android:layout_height="100dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"/>

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Number\nFinding\nGame"
                android:textSize="30sp"
                android:textColor="#000000"
                android:gravity="right"
                android:fontFamily="@font/sono"/>
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="32dp"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMap"
            style="@style/MenuButton"
            android:text="Chế độ map"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnGiaiTri"
            style="@style/MenuButton"
            android:text="Giải trí"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCaiDat"
            style="@style/MenuButton"
            android:text="Cài đặt"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnTaiKhoan"
            style="@style/MenuButton"
            android:text="Tài khoản"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBangXepHang"
            style="@style/MenuButton"
            android:text="Bảng xếp hạng"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnBanBe"
            style="@style/MenuButton"
            android:text="Bạn bè"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnCuaHang"
            style="@style/MenuButton"
            android:text="Cửa hàng"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnLichSu"
            style="@style/MenuButton"
            android:text="Lịch sử đấu"/>

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnThoat"
            style="@style/MenuButton"
            android:text="Thoát"/>

    </LinearLayout>

</ScrollView>