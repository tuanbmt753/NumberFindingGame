<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/linearLayoutTinNhanTong"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/txtThoiGianTinNhan"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="7dp"
        android:breakStrategy="high_quality"
        android:fontFamily="@font/sono"
        android:text="thoi gian"
        android:textColor="#000000"
        android:textSize="12sp"
        android:visibility="gone" />

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:orientation="horizontal"
        android:paddingHorizontal="15dp"
        android:paddingTop="7dp"
        android:paddingBottom="2dp">

        <!-- Avatar người gửi -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgAvatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_avatar"
            android:scaleType="centerCrop"
            android:src="@drawable/avatar_default"
            android:visibility="visible"
            app:shapeAppearanceOverlay="@style/CircleImage" />

        <!-- Nội dung tin nhắn -->
        <LinearLayout
            android:id="@+id/linearLayoutNoiDungTinNhan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:gravity="start"
            android:orientation="vertical">

            <!-- Tin nhắn văn bản -->
            <LinearLayout
                android:id="@+id/linearLayoutTinNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tin_nhan"
                android:orientation="vertical"
                android:padding="10dp"
                android:visibility="visible">

                <TextView
                    android:id="@+id/txtTinNhan"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:breakStrategy="high_quality"
                    android:fontFamily="@font/sono"
                    android:textColor="#000000"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/txtThoiGian"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/sono"
                    android:textColor="#A2B3A3"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- Tin nhắn hình ảnh -->
            <LinearLayout
                android:id="@+id/linearLayoutImgTinNhan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="start"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgTinNhan"
                    android:layout_width="150dp"
                    android:layout_height="150dp"
                    android:background="@drawable/bg_avatar"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_launcher_background"
                    app:shapeAppearanceOverlay="@style/CircleTinNhanHinhAnh" />

                <TextView
                    android:id="@+id/txtThoiGian2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/sono"
                    android:textColor="#A2B3A3"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</LinearLayout>